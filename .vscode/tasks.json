{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "path": "packages/extension",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}/packages/extension"],
        "pattern": {
          "regexp": "^\\s*(?:✘|▲)\\s+\\[(\\w+)\\]\\s+(.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[watch\\] build started",
          "endsPattern": "(\\[watch\\] build finished|build finished)"
        }
      },
      "label": "npm: watch - packages/extension"
    }
  ]
}
