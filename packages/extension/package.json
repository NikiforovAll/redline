{
  "name": "redline-extension",
  "displayName": "Claude Code Redline",
  "description": "Review agent diffs in VS Code and send comments back to Claude Code.",
  "version": "0.2.2",
  "publisher": "nikiforovall",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikiforovAll/redline.git"
  },
  "homepage": "https://nikiforovall.blog/redline/",
  "bugs": {
    "url": "https://github.com/nikiforovall/redline/issues"
  },
  "keywords": ["code review", "diff", "claude code", "ai", "agent"],
  "galleryBanner": {
    "color": "#1b1b1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "redline.submitReview",
        "title": "Redline: Submit review",
        "icon": "$(check-all)"
      },
      {
        "command": "redline.openRound",
        "title": "Redline: Open review round"
      },
      {
        "command": "redline.openLatestRound",
        "title": "Redline: Open latest round"
      },
      {
        "command": "redline.nextNote",
        "title": "Redline: Next note",
        "icon": "$(arrow-down)"
      },
      {
        "command": "redline.previousNote",
        "title": "Redline: Previous note",
        "icon": "$(arrow-up)"
      },
      {
        "command": "redline.clearRounds",
        "title": "Redline: Drop all review rounds",
        "icon": "$(clear-all)"
      },
      {
        "command": "redline.compare",
        "title": "Redline: Compare…",
        "icon": "$(git-compare)"
      },
      {
        "command": "redline.reply",
        "title": "Comment"
      },
      {
        "command": "redline.sendThread",
        "title": "Send to Agent",
        "icon": "$(send)"
      },
      {
        "command": "redline.resolveThread",
        "title": "Mark resolved",
        "icon": "$(pass)"
      },
      {
        "command": "redline.reopenThread",
        "title": "Reopen thread",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "redline.openRoundById",
        "title": "Open round",
        "icon": "$(go-to-file)"
      },
      {
        "command": "redline.revealNote",
        "title": "Go to note"
      },
      {
        "command": "redline.toggleView",
        "title": "Toggle Redline view",
        "category": "Redline"
      },
      {
        "command": "redline.openFileDiff",
        "title": "Open file diff"
      },
      {
        "command": "redline.submitRound",
        "title": "Submit review",
        "icon": "$(send)"
      },
      {
        "command": "redline.refreshRound",
        "title": "Redline: Refresh round",
        "icon": "$(sync)"
      },
      {
        "command": "redline.reloadView",
        "title": "Reload view",
        "icon": "$(refresh)"
      },
      {
        "command": "redline.dropRound",
        "title": "Redline: Drop review round",
        "icon": "$(trash)"
      },
      {
        "command": "redline.copyRoundId",
        "title": "Redline: Copy round id",
        "icon": "$(copy)"
      },
      {
        "command": "redline.copyNoteId",
        "title": "Copy note id",
        "icon": "$(copy)"
      },
      {
        "command": "redline.copyNoteMarkdown",
        "title": "Copy note as Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "redline.deleteNote",
        "title": "Delete note",
        "icon": "$(trash)"
      },
      {
        "command": "redline.resolveNote",
        "title": "Mark resolved",
        "icon": "$(pass)"
      },
      {
        "command": "redline.reopenNote",
        "title": "Reopen note",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "redline.sendNote",
        "title": "Send to Agent",
        "icon": "$(send)"
      },
      {
        "command": "redline.deleteResolvedNotes",
        "title": "Delete resolved notes",
        "icon": "$(trash)"
      },
      {
        "command": "redline.deleteAllNotes",
        "title": "Delete all notes",
        "icon": "$(trash)"
      },
      {
        "command": "redline.editComment",
        "title": "Edit comment",
        "icon": "$(edit)"
      },
      {
        "command": "redline.deleteComment",
        "title": "Delete comment",
        "icon": "$(trash)"
      },
      {
        "command": "redline.saveComment",
        "title": "Save"
      },
      {
        "command": "redline.cancelEditComment",
        "title": "Cancel"
      },
      {
        "command": "redline.openWalkthrough",
        "title": "Redline: Get started"
      },
      {
        "command": "redline.installPlugin",
        "title": "Redline: Install the Claude Code plugin"
      },
      {
        "command": "redline.checkPlugin",
        "title": "Redline: Check the Claude Code plugin"
      },
      {
        "command": "redline.resetOnboarding",
        "title": "Redline: Reset onboarding"
      }
    ],
    "walkthroughs": [
      {
        "id": "redline.gettingStarted",
        "title": "Get started with Redline",
        "description": "Install the Claude Code plugin, open a review round, and send comments back to Claude.",
        "steps": [
          {
            "id": "redline.installPlugin",
            "title": "Install the Claude Code plugin",
            "description": "Redline needs the redline plugin in Claude Code. The button runs the install in a terminal.\n[Install plugin](command:redline.installPlugin)\n[Check again](command:redline.checkPlugin)",
            "media": {
              "markdown": "media/walkthrough/install-plugin.md"
            },
            "completionEvents": ["onContext:redline.pluginInstalled"]
          },
          {
            "id": "redline.firstRound",
            "title": "Open a review round",
            "description": "Ask Claude Code to /redline:redline-tour a change, or compare two refs yourself with Redline: Compare…",
            "media": {
              "markdown": "media/walkthrough/first-round.md"
            },
            "completionEvents": ["onContext:redline.hasRounds"]
          },
          {
            "id": "redline.commentAndSend",
            "title": "Comment and send back",
            "description": "Leave comments on the diff, then send a thread or submit the whole review to Claude with Redline: Submit review.",
            "media": {
              "markdown": "media/walkthrough/comment-and-send.md"
            },
            "completionEvents": ["onCommand:redline.sendThread", "onCommand:redline.submitReview", "onCommand:redline.submitRound"]
          }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "redline",
          "title": "Redline",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "redline": [
        {
          "id": "redline.rounds",
          "name": "Review rounds",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Redline review rounds"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "redline.rounds",
        "contents": "No review rounds yet. Ask Claude Code to /redline:redline-tour the changes, or pick two refs to compare here and run /redline:redline-connect in Claude Code to pick up your comments.\n[Compare…](command:redline.compare)",
        "when": "redline.pluginInstalled"
      },
      {
        "view": "redline.rounds",
        "contents": "Redline needs the Claude Code plugin to open rounds and pick up your comments.\n[Install the Claude Code plugin](command:redline.installPlugin)\n[Get started](command:redline.openWalkthrough)",
        "when": "!redline.pluginInstalled"
      }
    ],
    "keybindings": [
      {
        "command": "redline.nextNote",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]"
      },
      {
        "command": "redline.previousNote",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+["
      },
      {
        "command": "redline.openLatestRound",
        "key": "ctrl+alt+r o",
        "mac": "cmd+alt+r o"
      },
      {
        "command": "redline.openRound",
        "key": "ctrl+alt+r h",
        "mac": "cmd+alt+r h"
      },
      {
        "command": "redline.submitReview",
        "key": "ctrl+alt+r s",
        "mac": "cmd+alt+r s"
      },
      {
        "command": "redline.compare",
        "key": "ctrl+alt+r c",
        "mac": "cmd+alt+r c"
      },
      {
        "command": "redline.sendThread",
        "key": "ctrl+alt+r enter",
        "mac": "cmd+alt+r enter"
      },
      {
        "command": "redline.resolveThread",
        "key": "ctrl+alt+r r",
        "mac": "cmd+alt+r r"
      },
      {
        "command": "redline.toggleView",
        "key": "ctrl+alt+r v",
        "mac": "cmd+alt+r v"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "redline.reply",
          "when": "false"
        },
        {
          "command": "redline.sendThread",
          "when": "false"
        },
        {
          "command": "redline.resolveThread",
          "when": "false"
        },
        {
          "command": "redline.reopenThread",
          "when": "false"
        },
        {
          "command": "redline.openRoundById",
          "when": "false"
        },
        {
          "command": "redline.revealNote",
          "when": "false"
        },
        {
          "command": "redline.openFileDiff",
          "when": "false"
        },
        {
          "command": "redline.submitRound",
          "when": "false"
        },
        {
          "command": "redline.reloadView",
          "when": "false"
        },
        {
          "command": "redline.copyNoteId",
          "when": "false"
        },
        {
          "command": "redline.copyNoteMarkdown",
          "when": "false"
        },
        {
          "command": "redline.deleteNote",
          "when": "false"
        },
        {
          "command": "redline.resolveNote",
          "when": "false"
        },
        {
          "command": "redline.reopenNote",
          "when": "false"
        },
        {
          "command": "redline.sendNote",
          "when": "false"
        },
        {
          "command": "redline.deleteResolvedNotes",
          "when": "false"
        },
        {
          "command": "redline.deleteAllNotes",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "redline.submitRound",
          "group": "inline@1",
          "when": "view == redline.rounds && viewItem == redline.round.open"
        },
        {
          "command": "redline.refreshRound",
          "group": "inline@2",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.round\\./"
        },
        {
          "command": "redline.openRoundById",
          "group": "inline@3",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.round\\./"
        },
        {
          "command": "redline.copyRoundId",
          "group": "1_manage@0",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.round\\./"
        },
        {
          "command": "redline.dropRound",
          "group": "1_manage@1",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.round\\./"
        },
        {
          "command": "redline.deleteResolvedNotes",
          "group": "1_manage@0",
          "when": "view == redline.rounds && viewItem == redline.notes"
        },
        {
          "command": "redline.deleteAllNotes",
          "group": "1_manage@1",
          "when": "view == redline.rounds && viewItem == redline.notes"
        },
        {
          "command": "redline.sendNote",
          "group": "1_act@0",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.(draft|submitted)$/"
        },
        {
          "command": "redline.resolveNote",
          "group": "1_act@1",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.(note|draft|submitted|sent)$/"
        },
        {
          "command": "redline.reopenNote",
          "group": "1_act@1",
          "when": "view == redline.rounds && viewItem == redline.resolved"
        },
        {
          "command": "redline.copyNoteId",
          "group": "2_manage@0",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.(note|draft|submitted|sent|resolved)$/"
        },
        {
          "command": "redline.copyNoteMarkdown",
          "group": "2_manage@1",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.(note|draft|submitted|sent|resolved)$/"
        },
        {
          "command": "redline.deleteNote",
          "group": "2_manage@2",
          "when": "view == redline.rounds && viewItem =~ /^redline\\.(note|draft|submitted|sent|resolved)$/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "redline.reply",
          "group": "inline@1",
          "when": "commentController == redline"
        },
        {
          "command": "redline.sendThread",
          "group": "inline@2",
          "when": "commentController == redline && !(commentThread =~ /^redline\\.resolved\\./)"
        }
      ],
      "comments/comment/title": [
        {
          "command": "redline.editComment",
          "group": "inline@1",
          "when": "commentController == redline && comment == redline.human"
        },
        {
          "command": "redline.deleteComment",
          "group": "inline@2",
          "when": "commentController == redline && comment == redline.human"
        }
      ],
      "comments/comment/context": [
        {
          "command": "redline.saveComment",
          "group": "inline@1",
          "when": "commentController == redline && comment == redline.human"
        },
        {
          "command": "redline.cancelEditComment",
          "group": "inline@2",
          "when": "commentController == redline && comment == redline.human"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "redline.sendThread",
          "group": "navigation@1",
          "when": "commentController == redline && commentThread =~ /^redline\\.(draft|submitted)\\./"
        },
        {
          "command": "redline.resolveThread",
          "group": "navigation@2",
          "when": "commentController == redline && commentThread =~ /^redline\\.(note|draft|submitted|sent)\\./"
        },
        {
          "command": "redline.reopenThread",
          "group": "navigation@2",
          "when": "commentController == redline && commentThread =~ /^redline\\.resolved\\./"
        }
      ],
      "view/title": [
        {
          "command": "redline.submitRound",
          "group": "navigation@1",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.previousNote",
          "group": "navigation@2",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.nextNote",
          "group": "navigation@3",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.compare",
          "group": "navigation@0",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.openLatestRound",
          "group": "1_actions@2",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.refreshRound",
          "group": "1_actions@3",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.copyRoundId",
          "group": "1_actions@4",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.reloadView",
          "group": "2_manage@1",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.dropRound",
          "group": "2_manage@2",
          "when": "view == redline.rounds"
        },
        {
          "command": "redline.clearRounds",
          "group": "navigation@4",
          "when": "view == redline.rounds && redline.hasRounds"
        }
      ]
    },
    "configuration": {
      "title": "Redline",
      "properties": {
        "redline.avatar": {
          "type": "string",
          "enum": ["github", "none"],
          "default": "github",
          "enumDescriptions": [
            "Show the login and avatar of the GitHub account VS Code is signed in with. Nothing is fetched until a session exists.",
            "Show the OS user name with the built-in icon."
          ],
          "description": "Identity shown on your review comments."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "proto-server": "node scripts/proto-server.mjs"
  },
  "dependencies": {
    "@nikiforovall/redline-mcp": "*",
    "@redline/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vscode-uri": "^3.0.8"
  }
}
